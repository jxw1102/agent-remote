{
  "bind": "0.0.0.0",
  "port": 8473,
  "providers": ["claude", "grok", "codex", "deepseek", "cursor"],

  "claude_bin": "claude",
  "permission_mode": "bypassPermissions",
  "permission_timeout": 300,
  "claude_env": {},

  "grok_bin": "grok",
  "grok_home": "~/.grok",
  "grok_prompt_flags": "--yolo --deny Bash(rm*) --deny Bash(sudo*) --deny Bash(*--force*)",
  "grok_default_cwd": "",
  "grok_env": {},

  "codex_bin": "codex",
  "codex_home": "~/.codex",
  "codex_sandbox": "danger-full-access",
  "codex_exec_flags": "",
  "codex_env": {},

  "dsh_url": "http://127.0.0.1:3080",
  "dsh_home": "~/.dsh",
  "dsh_bin": "dsh",
  "dsh_manage": true,

  "cursor_bin": "cursor-agent",
  "cursor_home": "~/.cursor",
  "cursor_prompt_flags": "--force --trust",
  "cursor_tui_flags": "--force --trust --approve-mcps",
  "cursor_env": {},

  "turn_timeout": 1800
}
