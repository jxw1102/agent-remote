[Unit]
Description=agentremoted — agent sessions for Agent Remote clients
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bb10-remote/daemon
# Config: ~/.agentremoted/config.json  ("providers": [...], port, tls_cert/tls_key, …)
# Token:  ~/.agentremoted/token
Environment=AGENTREMOTED_HOME=/root/.agentremoted
Environment=PYTHONPATH=/opt/bb10-remote/daemon
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/root/.grok/bin:/root/.local/bin
Environment=HOME=/root
ExecStart=/usr/bin/python3 -m agentremoted
Restart=on-failure
RestartSec=3
# Signal ONLY the daemon on stop/restart. The default (control-group) kills
# every process in the cgroup, which includes the tmux server the daemon
# spawned — so every interactive TUI died on each restart/redeploy. The
# daemon re-adopts running TUIs from grok-tuis.json at startup.
KillMode=process
TimeoutStopSec=30
# Interactive mode spawns the tmux server and agent TUIs inside this cgroup;
# each TUI is a node process in the hundreds of MB.
MemoryMax=1200M
MemoryHigh=900M

[Install]
WantedBy=multi-user.target
